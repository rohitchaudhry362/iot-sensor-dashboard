# HomePulse configuration.
#
# `docker compose up` needs NONE of this: every value below is also defaulted in docker-compose.yml, so a fresh
# clone starts without a .env file at all. Copy this to .env only to override something, or when running the
# services directly on the host with `npm run dev`.
#
# The two sets of values differ in one important way: inside compose the services find each other by service
# name (postgres, mosquitto), while on the host they are on localhost. The values here are the host ones.

# ---- Published ports -------------------------------------------------------
# Only used by docker compose, to map container ports onto the host. Change one if something already owns it
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
MQTT_PORT=1883

# ---- Postgres --------------------------------------------------------------
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_password
POSTGRES_DB=iot_dashboard

# ---- Backend ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://iot:iot_password@localhost:5432/iot_dashboard
# Folder holding activity.json and sensors.json, read once by the seed. Defaults to ../data on the host; compose
# mounts the repo's ./data at /data read-only and sets this to /data.
# DATA_DIR=

# ---- Auth ------------------------------------------------------------------
# At least 32 characters. The compose default is a known development string; a real deployment injects a secret.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
# Defaults to true when NODE_ENV=production, which marks the refresh cookie Secure - so the browser will only
# send it over HTTPS. Compose forces it to false because the demo is served over plain HTTP; left true there,
# the refresh cookie would never come back and every session would die after the access token's 15 minutes.
# COOKIE_SECURE=

# ---- MQTT ------------------------------------------------------------------
# Used by the backend and the simulator. Inside compose this is mqtt://mosquitto:1883.
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=homepulse-backend

# ---- Simulator -------------------------------------------------------------
NETWORK_ID=1

# ---- Frontend --------------------------------------------------------------
# Read by vite.config.ts to point the Vite server (dev, and `vite preview` in Docker) at the backend. The built
# app hard-codes no backend URL: it calls /api and /socket.io on its own origin, and Vite forwards them.
# VITE_BACKEND_URL=http://localhost:4000
