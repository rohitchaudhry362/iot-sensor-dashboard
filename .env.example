# Postgres (used by docker compose)
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_password
POSTGRES_DB=iot_dashboard

# Backend
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://iot:iot_password@localhost:5432/iot_dashboard
# Optional: folder containing activity.json and sensors.json (defaults to ../data)
# DATA_DIR=

# Auth
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
# Defaults to true when NODE_ENV=production (cookies only sent over HTTPS)
# COOKIE_SECURE=

# MQTT broker (used by the backend and the simulator)
MQTT_URL=mqtt://localhost:1883
# Backend only: the broker keeps a persistent session for this id, so keep it fixed
MQTT_CLIENT_ID=homepulse-backend

# Simulator (simulator/)
NETWORK_ID=1
